  "episodes": [
    {
      "id": 1,
      "source_id": 1,
      "source_key": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "segment_index": 0,
      "text": "セイア与クズノハ对话。クズノハ指出セイア遭遇了“色彩”，这是一种来自基沃托斯之外、能引发古老灾祸、对基沃托斯居民是致命毒药的存在，会扭曲个体本质。セイア并非直接接触，而是通过“白昼梦”和“仪式”间接窥见，因此暂时保持意识。クズノハ告知セイア这种安全状态无法长久维持，并提出一个解决方案：需要セイア放弃一个构成自身的本质作为代价，才能脱离色彩侵蚀。セイア询问是否没有其他选择。",
      "participants_json": "[\"セイア\", \"クズノハ\", \"ベアトリーチェ\"]",
      "event_type": "对话_诊断与提议",
      "story_time_text": "",
      "story_order": null,
      "timeline_scope": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "confidence": 0.85
    },
    {
      "id": 2,
      "source_id": 1,
      "source_key": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "segment_index": 0,
      "text": "黑服、マエストロ、ゴルコンダ、ベアトリーチェ聚集。黑服解释了“名もなき神”和崇拜它的“無名の司祭”，指出他们的技术遗产仍在交易。ゴルコンダ报告观测到了“箱舟”。黑服推测“箱舟”可能是包含所有神秘的抽象概念，并列举了一系列计划外的变数：无名司祭的兵力和遗产被再次观测、シャーレ的出现、未能确保基沃托斯最高神秘、以及“箱舟”的观测。",
      "participants_json": "[\"黒服 / 黑服 / Black Suit / 검은 양복\", \"マエストロ\", \"ゴルコンダ\", \"ベアトリーチェ\"]",
      "event_type": "会议_情报共享与局势分析",
      "story_time_text": "",
      "story_order": null,
      "timeline_scope": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "confidence": 1.0
    },
    {
      "id": 3,
      "source_id": 1,
      "source_key": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "segment_index": 0,
      "text": "マエストロ指出仪式是为了接触“色彩”，ゴルコンダ纠正说是为了利用其力量。ベアトリーチェ斥责了マエストロ的傲慢态度，并与ゴルコンダ发生口角。随后，ベアトリーチェ宣布“色彩”已经发现了他们的位置，并更准确地说明是她自己将信息传递给了“色彩”，令在场众人震惊。",
      "participants_json": "[\"マエストロ\", \"ゴルコンダ\", \"ベアトリーチェ\", \"黒服 / 黑服 / Black Suit / 검은 양복\"]",
      "event_type": "对话_冲突与背叛宣告",
      "story_time_text": "",
      "story_order": null,
      "timeline_scope": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "confidence": 1.0
    },
    {
      "id": 4,
      "source_id": 1,
      "source_key": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "segment_index": 0,
      "text": "アロナ与老师互动。老师检查アロナ是否被枪击过，アロナ否认并表示自己没事。老师向アロナ描述了梦境：一个所有色彩褪去的黑白世界，一个扭曲的ヘイロー少女用枪指着老师。セイア疑惑为何老师会看到和自己相同的预知梦，并认为这与之前被告知的“基沃托斯的终焉”有关。アロナ安慰老师。",
      "participants_json": "[\"アロナ / 阿罗娜 / Arona / 아로나\", \"先生 / 老师 / Sensei / 선생님\", \"セイア\"]",
      "event_type": "对话_分享噩梦与担忧",
      "story_time_text": "",
      "story_order": null,
      "timeline_scope": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "confidence": 0.85
    },
    {
      "id": 5,
      "source_id": 1,
      "source_key": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "segment_index": 0,
      "text": "老师告知アロナ打算将关于“终焉”的预知梦告诉联邦学生会的リン。アロナ对此表示担忧，但选择支持老师。老师随后在联邦学生会办公室与リン会面，向她讲述了预知梦和“终焉”的警告。リン指出缺乏证据和时间不确定。但在老师解释后，リン表示会出于对联邦学生会长指派的老师的义务，去查阅联邦学生会和百鬼夜行自治区的记录以寻找线索，并承诺之后联系老师，但强调说服其他学生会需要证据。",
      "participants_json": "[\"先生 / 老师 / Sensei / 선생님\", \"アロナ / 阿罗娜 / Arona / 아로나\", \"リン\"]",
      "event_type": "对话_情报传达与任务委托",
      "story_time_text": "",
      "story_order": null,
      "timeline_scope": "000__主线剧情_最終編_第1章__segment-0000.txt",
      "confidence": 0.85
    }
