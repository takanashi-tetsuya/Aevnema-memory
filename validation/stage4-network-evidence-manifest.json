  "execution_protocol": {
    "modes": ["vector_only", "graph_static", "graph_growing"],
    "phase_1": "每题使用新的评测副本单独运行，先定位召回/推理/增长问题。",
    "phase_2": "七题按固定顺序在同一 graph_growing 副本连续运行，检查新边是否被后题复用。",
    "phase_3": "至少三种问题顺序重跑连续增长，以暴露路径依赖、边爆炸和错误强化。",
    "phase_4": "人工逐条复核所有新建/强化边的 claim_level、evidence_json、audit_json 和最终答案路径。"
  },
  "acceptance": {
    "hard": [
      "required_episode_groups 记录精确 Episode 召回覆盖，作为诊断值；Source 摘录可能提供同一原文证据，因此该 ID 覆盖不单独决定整题通过",
      "required_sources 记录预设跨文件证据覆盖，作为诊断值；同一事实可能在允许语料的其他文件中被完整重述",
      "末次 answer audit 为 valid",
      "答案必须包含 required_terms；事实、推论/分析与未知边界由 Source 原文增强后的答案审计判定，required_term_groups 仅作格式诊断",
      "vector_only 不使用 Association；graph_static 使用既有 Association；graph_growing 的变化边必须被实际答案路径使用",
      "不得在 allowed_source_keys 之外引入剧情事实"
    ],
    "growth_safety_checks_not_quantity_metrics": [
      "如发生新增或强化，关系必须带 dual_accepted、两端 evidence_json 和 audit_json",
      "如发生新增或强化，变化边必须进入当前或后续答案路径才视为有用",
      "严重越界边（错误身份、虚构具体机制、推测升级为事实）为 0",
      "不统计、不要求、不建议任何新增或强化边数量"
    ]
  }
