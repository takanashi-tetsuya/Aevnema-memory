SILICONFLOW_API_KEY=
TELEGRAM_BOT_TOKEN=
MEMORY_DB_PATH=database/memory_demo.db
MEMORY_LOG_DIR=logs
MEMORY_REASONING_MAX_TOKENS=8000
MEMORY_IMPORT_TASK_MAX_ATTEMPTS=2
# A clean empty Episode result is skipped only after a source-only audit by
# this independently configured model. Keep it different from the extractor.
MEMORY_IMPORT_EMPTY_EPISODE_AUDIT_MODE=adversarial
MEMORY_IMPORT_EMPTY_EPISODE_AUDIT_MODEL=zai-org/GLM-4.5-Air
MEMORY_REASONING_MODEL=deepseek-ai/DeepSeek-V3.2
MEMORY_FALLBACK_MODEL=zai-org/GLM-4.5V
MEMORY_SEGMENT_TARGET_CHARS=6000
MEMORY_SEGMENT_MAX_CHARS=8000
MEMORY_SEGMENT_OVERLAP_CHARS=800
MEMORY_PARAGRAPH_ENABLED=0
MEMORY_CONCEPT_PROFILE=fine_grained
MEMORY_SPARSE_ENABLED=1
MEMORY_SOURCE_KEY_COHORT_ENABLED=1
MEMORY_RERANK_ENABLED=1
MEMORY_RERANK_COVERAGE_AUDIT_ENABLED=1
MEMORY_GROWTH_PERSIST_ONLY_USED=1
MEMORY_GROWTH_COUNTERFACTUAL_UTILITY_ENABLED=1
MEMORY_GROWTH_STAGING_ENABLED=1
# Contextual association v1 (local-only, disabled by default)
MEMORY_CONTEXTUAL_ASSOCIATION_ENABLED=0
MEMORY_CONTEXTUAL_ASSOCIATION_SHADOW=1
MEMORY_CONTEXTUAL_ASSOCIATION_ALLOW_NETWORK=0
MEMORY_CONTEXTUAL_ASSOCIATION_CONTEXT_TOP_K=8
MEMORY_CONTEXTUAL_ASSOCIATION_NEED_TOP_K=8
MEMORY_CONTEXTUAL_ASSOCIATION_EDGE_TOP_K=16
MEMORY_CONTEXTUAL_ASSOCIATION_CONTEXT_THRESHOLD=0.55
MEMORY_CONTEXTUAL_ASSOCIATION_NEED_THRESHOLD=0.55
MEMORY_CONTEXTUAL_ASSOCIATION_COMBINE_MODE=product
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_LIGHT=1
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_STANDARD=2
MEMORY_CONTEXTUAL_ASSOCIATION_ENDPOINT_LIMIT_DEEP=4
MEMORY_CONTEXTUAL_ASSOCIATION_MAX_CANDIDATES_PER_TURN=8
MEMORY_CONTEXTUAL_ASSOCIATION_PROBATION_LIMIT=10000
MEMORY_CONTEXTUAL_ASSOCIATION_PROBATION_TTL=2592000
MEMORY_CONTEXTUAL_ASSOCIATION_MIN_DISTINCT_SUCCESSES=2
MEMORY_CONTEXTUAL_ASSOCIATION_PROMOTION_ENABLED=0
MEMORY_CONTEXTUAL_ASSOCIATION_NOOP_DECAY=0.98
MEMORY_CONTEXTUAL_ASSOCIATION_HARM_MULTIPLIER=0.5
